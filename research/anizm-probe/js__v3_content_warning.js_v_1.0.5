(() => {
    const dialog = document.querySelector('[data-v3-content-warning]');
    if (!dialog) {
        window.v3ContentWarningAccepted = true;
        return;
    }

    const rating = Number(dialog.dataset.rating);
    const animeId = Number(dialog.dataset.animeId);
    const accountManaged = dialog.dataset.accountManaged === '1';
    const sessionStorageKey = `anizm.v3.content-warning.${animeId}`;
    const rememberedStorageKey = 'anizm.v3.content-warning.remembered-rating';
    const readSessionRating = () => {
        try {
            return Number(window.sessionStorage.getItem(sessionStorageKey)) || 0;
        } catch (_) {
            return 0;
        }
    };
    const readRememberedRating = () => {
        try {
            return Number(window.localStorage.getItem(rememberedStorageKey)) || 0;
        } catch (_) {
            return 0;
        }
    };
    const accepted = Math.max(readSessionRating(), accountManaged ? 0 : readRememberedRating()) >= rating;
    window.v3ContentWarningAccepted = accepted;

    const unlock = () => {
        window.v3ContentWarningAccepted = true;
        document.body.classList.remove('v3-content-warning-open');
        if (dialog.open) dialog.close();
        document.dispatchEvent(new CustomEvent('v3:content-warning-accepted'));
    };

    document.addEventListener('DOMContentLoaded', () => {
        if (!accepted) {
            document.body.classList.add('v3-content-warning-open');
            try {
                dialog.showModal();
            } catch (_) {
                dialog.setAttribute('open', '');
            }
        }

        dialog.addEventListener('cancel', event => event.preventDefault());
        const preferenceDialog = document.querySelector('[data-v3-content-warning-preference]');
        const preferenceDescription = preferenceDialog?.querySelector('#v3-content-warning-preference-description');
        let requestedMode = 'only_18';
        const openPreferenceDialog = mode => {
            requestedMode = mode;
            if (preferenceDescription) {
                preferenceDescription.textContent = mode === 'none'
                    ? '18 yaşında veya daha büyük olduğumu onaylıyorum. Tercihim hesabıma kaydedilecek; +16 ve +18 içerik uyarılarının hiçbiri gösterilmeyecek. Bu anime uyarısı da bu oturumda tekrar gösterilmeyecek.'
                    : '18 yaşında veya daha büyük olduğumu onaylıyorum. Tercihim hesabıma kaydedilecek; +16 uyarıları gizlenecek, +18 içerik uyarıları gösterilmeye devam edecek. Bu anime uyarısı bu oturumda tekrar gösterilmeyecek.';
            }
            try {
                preferenceDialog?.showModal();
            } catch (_) {
                preferenceDialog?.setAttribute('open', '');
            }
        };
        const accept = remember => {
            try {
                window.sessionStorage.setItem(sessionStorageKey, String(Math.max(readSessionRating(), rating)));
            } catch (_) {
                // The current page can continue even when browser storage is unavailable.
            }

            if (remember) {
                try {
                    window.localStorage.setItem(rememberedStorageKey, String(Math.max(readRememberedRating(), rating)));
                } catch (_) {
                    // The current page can continue even when browser storage is unavailable.
                }
            }

            unlock();
        };

        dialog.querySelector('[data-v3-content-warning-accept]')?.addEventListener('click', () => accept(false));
        dialog.querySelectorAll('[data-v3-content-warning-remember]').forEach(button => {
            button.addEventListener('click', () => {
                const mode = button.dataset.v3ContentWarningRemember;
                if (!accountManaged || mode === 'browser') {
                    accept(true);
                    return;
                }

                openPreferenceDialog(mode || 'only_18');
            });
        });

        if (preferenceDialog) {
            const confirmation = preferenceDialog.querySelector('[data-v3-content-warning-preference-confirm]');
            const cancel = preferenceDialog.querySelector('[data-v3-content-warning-preference-cancel]');
            const error = preferenceDialog.querySelector('[data-v3-content-warning-save-error]');

            cancel?.addEventListener('click', () => preferenceDialog.close());
            confirmation?.addEventListener('click', async () => {
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
                if (!csrfToken) {
                    if (error) {
                        error.textContent = 'Güvenlik anahtarı okunamadı. Sayfayı yenileyip tekrar dene.';
                        error.hidden = false;
                    }
                    return;
                }

                confirmation.disabled = true;
                if (error) error.hidden = true;
                try {
                    const body = new FormData();
                    body.set('age_warning_mode', requestedMode);
                    body.set('age_warning_confirmation', '1');
                    const response = await fetch(preferenceDialog.dataset.saveUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            Accept: 'application/json',
                            'X-CSRF-TOKEN': csrfToken,
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body,
                    });
                    const result = await response.json();
                    if (!response.ok || result.mode !== requestedMode) throw new Error();

                    preferenceDialog.close();
                    accept(false);
                } catch (_) {
                    if (error) {
                        error.textContent = 'Tercih kaydedilemedi. Bağlantını kontrol edip tekrar dene.';
                        error.hidden = false;
                    }
                } finally {
                    confirmation.disabled = false;
                }
            });
        }

        if (accepted) unlock();
    });
})();
